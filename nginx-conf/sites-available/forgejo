server {
    listen 80;
    server_name asaeppel.dev www.asaeppel.dev;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name asaeppel.dev www.asaeppel.dev;

    ssl_certificate /etc/letsencrypt/live/asaeppel.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/asaeppel.dev/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/html;
    index src/index.html;

    # Security headers
    add_header X-Frame-Options "DENY";
    add_header X-Content-Type-Options "nosniff";
    add_header Referrer-Policy "strict-origin-when-cross-origin";
    add_header X-XSS-Protection "1; mode=block";

    location / {
        limit_req zone=one burst=40 nodelay;
        try_files $uri $uri/ /src$uri.html =404;
    }

    location ~ ^/([A-Za-z0-9_-]+)\.css$ {
        limit_req zone=one burst=40 nodelay;

        try_files $uri /src$uri =404;
    }

}

server {
    listen 80;
    server_name code.asaeppel.dev;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name code.asaeppel.dev;

    ssl_certificate /etc/letsencrypt/live/code.asaeppel.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/code.asaeppel.dev/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        limit_req zone=one burst=40 nodelay;

        proxy_pass http://127.0.0.1:3000;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
	    proxy_set_header X-Forwarded-Ssl on;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

}
